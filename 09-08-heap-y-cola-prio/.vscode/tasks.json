{
   "version": "2.0.0",
   "tasks": [
      {
         "label": "g++ build active file",
         "type": "shell",
         "command": "g++",
         "args": [
            "-g",
            "-std=c++17",
            "${file}",
            "-o",
            "${fileDirname}/${fileBasenameNoExtension}"
         ],
         "options": {
            "cwd": "${fileDirname}"
         },
         "problemMatcher": [
            "$gcc"
         ],
         "group": {
            "kind": "build",
            "isDefault": true
         }
      }
   ]
}
